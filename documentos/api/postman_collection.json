        {
          "name": "5.5 [Fluxo 1] Verificar Lembrete gerado automaticamente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/lembretes?tipo=Retorno&size=100",
            "description": "Confirma o Fluxo 1: registrar consulta deve ter gerado automaticamente um Lembrete de Retorno para o pet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var petId = parseInt(pm.collectionVariables.get(\"petId\"));",
                  "var lembretes = pm.response.json().content;",
                  "pm.test(\"Existe um lembrete de Retorno gerado para o pet da consulta\", function () {",
                  "    var encontrado = lembretes.some(function (l) { return l.petId === petId; });",
                  "    pm.expect(encontrado).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.6 [Fluxo 1] Verificar Recomendação gerada automaticamente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/recomendacoes?tipo=Cuidado&size=100",
            "description": "Confirma o Fluxo 1: registrar consulta deve ter gerado automaticamente uma Recomendacao de Cuidado Pos-Consulta para o pet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var petId = parseInt(pm.collectionVariables.get(\"petId\"));",
                  "var recomendacoes = pm.response.json().content;",
                  "pm.test(\"Existe uma recomendação de Cuidado gerada para o pet da consulta\", function () {",
                  "    var encontrado = recomendacoes.some(function (r) { return r.petId === petId; });",
                  "    pm.expect(encontrado).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]

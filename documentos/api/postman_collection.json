                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Resposta e uma lista\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "15.2 [Security] Tutor não pode ver retenção de outros (esperado: 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/clinicas/{{clinicaId}}/retencao",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{tutorEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{tutorSenha}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403 Forbidden\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
